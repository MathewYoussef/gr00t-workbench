# Container image to run (recipe-only repo; you pull/build this on your machine)
GR00T_IMAGE=nvcr.io/nvidia/pytorch:25.11-py3

# Where Isaac-GR00T lives on the host (recommended: sibling repo)
ISAAC_GR00T_DIR=../Isaac-GR00T

# Optional: pin Isaac-GR00T to a specific commit/tag when cloning with scripts/clone_isaac_gr00t.sh
# Example: ISAAC_GR00T_REF=d483f00b1c13116bda020bead9d16dca497b2f6d
ISAAC_GR00T_REF=

# Host data disk to mount (datasets, checkpoints, cache)
DATA_DIR=/mnt/nvme1

# Hugging Face cache root inside the container (should live on DATA_DIR)
HF_HOME=/mnt/nvme1/hf_cache_root
